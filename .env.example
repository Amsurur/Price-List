# Copy to .env and adjust. Never commit .env.

# --- Postgres (used by docker-compose and the API) ---
# Port 5433 (not 5432) to avoid clashing with a local Postgres you may already run.
DB_HOST=localhost
DB_PORT=5433
DB_USER=softclub
DB_PASSWORD=softclub
DB_NAME=softclub_store
# Alternatively a single URL (TypeORM will use this if set):
DATABASE_URL=postgres://softclub:softclub@localhost:5433/softclub_store
# Auto-creates/updates tables from entities. Handy for local dev; leave unset
# (or false) anywhere real data lives — no migrations exist yet, so drift
# between entities and the actual schema could silently alter/drop columns.
DB_SYNCHRONIZE=true

# --- Ports ---
API_PORT=3001
WEB_PORT=3000

# --- Web (Next.js public vars) ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_CURRENCY=$

# --- API CORS ---
WEB_ORIGIN=http://localhost:3000

# Product images are stored as bytes in Postgres (see product_images table),
# not on local disk — so no env var is needed for them to survive a redeploy.

# --- Telegram notifications (optional; skipped silently if unset) ---
# Message @BotFather on Telegram to create a bot and get this token.
TELEGRAM_BOT_TOKEN=
# Message @userinfobot (or call getUpdates on your bot after messaging it)
# to find the numeric chat ID to send admin notifications to.
# Comma-separate multiple IDs to notify more than one person, e.g. 111,222.
TELEGRAM_CHAT_ID=

# --- Admin auth (single owner account; JWT + guard on /admin, no users table) ---
# Generate JWT_SECRET with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-32-byte-string
JWT_EXPIRES_IN_SECONDS=604800
ADMIN_EMAIL=owner@softclubstore.local
# Generate with: node -e "console.log(require('bcrypt').hashSync('your-password', 10))" (run from apps/api)
# Wrap it in single quotes — the hash's $ characters otherwise trip docker
# compose's env-file variable interpolation (harmless but noisy warnings).
ADMIN_PASSWORD_HASH=''

# Controls the admin cookie's Secure/SameSite flags. Set to "true" only when
# served over HTTPS (a Secure cookie is silently refused by browsers over
# plain HTTP) — needed whenever the web app and API are on different domains
# (e.g. Vercel + Render) since that's cross-site and requires SameSite=None,
# which requires Secure. Leave unset/false for local dev and for a plain-HTTP
# deploy (e.g. a bare IP before a domain + TLS exist).
COOKIE_SECURE=false
